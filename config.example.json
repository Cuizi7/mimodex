{
  "host": "127.0.0.1",
  "port": 8787,
  "upstream": "https://token-plan-cn.xiaomimimo.com/v1",

  "model_map": {
    "codex-auto-review": "mimo-v2.6-flash",
    "gpt-5.6-luna": "mimo-v2.6-flash",
    "gpt-5.6-terra": "mimo-v2.6-flash",
    "gpt-5.6-sol": "mimo-v2.6-pro",
    "gpt-6-astra": "mimo-v2.6-pro",
    "gpt-5.5": "mimo-v2.6-pro",
    "gpt-reserve": "mimo-v2.6-pro"
  },

  "model_map_globs": {
    "gpt-*": "mimo-v2.6-pro"
  },

  "effort_map": {
    "minimal": "low",
    "xhigh": "high",
    "max": "high"
  },

  "default_model": null,

  "//连接管理": "上游用显式 Agent，不要改回内置 fetch —— 见 README「连接管理」一节",
  "max_sockets": 64,
  "max_free_sockets": 16,
  "keep_alive_msecs": 30000,
  "upstream_timeout_ms": 300000,

  "//可观测性": "sockWait 超过该阈值会打 WARN；stats 是周期性连接池快照的间隔",
  "socket_wait_warn_ms": 1000,
  "stats_interval_ms": 30000
}
